                if(article.category.includes('Metrik')) badgeColor = 'bg-brand-gold';
                if(article.category.includes('Sosial')) badgeColor = 'bg-teal-600';
                if(article.category.includes('Pembangunan')) badgeColor = 'bg-indigo-600';

                const cardHTML = `
                    <div class="bg-white rounded-2xl shadow-premium border border-slate-200 overflow-hidden flex flex-col h-full transform transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
                        <div class="h-48 overflow-hidden relative">
                            <img src="${article.image}" alt="${article.title}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-110">
                            <div class="absolute top-4 left-4 ${badgeColor} text-white text-xs font-bold px-3 py-1 rounded-full shadow">
                                ${article.category}
                            </div>
                        </div>
                        <div class="p-6 flex flex-col flex-grow">
                            <h3 class="font-heading font-bold text-xl text-brand-navy mb-3 line-clamp-2">${article.title}</h3>
                            <p class="text-slate-600 text-sm mb-6 flex-grow line-clamp-3">${article.excerpt}</p>
                            <button onclick="readMore(${article.id})" class="inline-flex items-center text-brand-red font-semibold hover:text-brand-redhover transition-colors mt-auto group">
                                Baca Lanjut 
                                <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </button>
                        </div>
                    </div>
                `;
                grid.innerHTML += cardHTML;
            });
        }

        function filterCategory(category) {
            // Update Active button styles
            const buttons = document.querySelectorAll('#category-filters button');
            buttons.forEach(btn => {
                if(btn.textContent.includes(category) || (category === 'All' && btn.textContent === 'Semua Topik')) {
                    btn.className = 'px-6 py-2 rounded-full bg-brand-navy text-white font-medium text-sm transition-colors shadow-md';
                } else {
                    btn.className = 'px-6 py-2 rounded-full bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 font-medium text-sm transition-colors shadow-sm';
                }
            });
            renderIndex(category);
        }

        function readMore(id) {
            const article = articlesData.find(a => a.id === id);
            if(!article) return;

            // Populate View
            document.getElementById('view-category').textContent = article.category;
            document.getElementById('view-title').textContent = article.title;
            document.getElementById('view-content').innerHTML = article.content;
            
            // Handle SEO Meta Display (for demonstration purposes on Article 1)
            const metaBox = document.getElementById('seo-meta-box');
            if(article.meta) {
                metaBox.classList.remove('hidden');
                document.getElementById('meta-keyword').textContent = article.meta.keyword;
                document.getElementById('meta-intent').textContent = article.meta.intent;
                document.getElementById('meta-desc').textContent = article.meta.desc;
            } else {
                metaBox.classList.add('hidden');
            }

            // Transition Views
            document.getElementById('index-view').classList.add('hidden');
            document.getElementById('article-view').classList.remove('hidden');
            
            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function showIndex() {
            document.getElementById('article-view').classList.add('hidden');
            document.getElementById('index-view').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Initialize on load
        window.onload = () => {
            renderIndex();
        };
    </script>
</body>
</html>
